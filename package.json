{
  "name": "acme-salary-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Salary management for ACME's HR team",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
